# scrappy environment variables
# Copy this file to .env and fill in your keys.
#   cp .env.example .env

# API Keys (bare names — these are what the code reads via os.Getenv)
ADZUNA_APP_ID=                 # https://developer.adzuna.com/
ADZUNA_APP_KEY=                # https://developer.adzuna.com/
CAREERJET_AFFID=               # https://www.careerjet.com/partners/
INFOJOBS_CLIENT_ID=            # https://developer.infojobs.net/
INFOJOBS_CLIENT_SECRET=        # https://developer.infojobs.net/
FINDWORK_API_KEY=              # https://findwork.dev/developers/
ARBEITSAGENTUR_API_KEY=        # https://rest.arbeitsagentur.de/
AUTHENTICJOBS_API_KEY=         # https://authenticjobs.com/api/

# Indeed (uses SCRAPPY_ prefix)
SCRAPPY_INDEED_API_KEY=        # Indeed API key (paid)
SCRAPPY_INDEED_CO=             # Indeed company override

# Dice (public client-side key, override if it changes)
SCRAPPY_DICE_API_KEY=

# Proxy & network
SCRAPPY_PROXIES=               # socks5://user:pass@host:port,...
SCRAPPY_PROXY_ROTATE_EVERY_N=1
SCRAPPY_PROXY_STICKY_WINDOW_N=1

# Logging
SCRAPPY_LOG_LEVEL=             # DEBUG|INFO|WARN|ERROR

# Auto-discovery seeds (comma-separated company slugs for ATS scrapers)
SCRAPPY_GREENHOUSE_SEEDS=stripe,airbnb,notion
SCRAPPY_ADP_SEEDS=
SCRAPPY_WORKABLE_SEEDS=
SCRAPPY_ASHBY_SEEDS=
SCRAPPY_BAMBOOHR_SEEDS=
SCRAPPY_JAZZHR_SEEDS=
SCRAPPY_TEAMTAILOR_SEEDS=
SCRAPPY_ICIMS_SEEDS=
SCRAPPY_WORKDAY_SEEDS=
SCRAPPY_SMARTRECRUITERS_SEEDS=
SCRAPPY_COMEET_SEEDS=
SCRAPPY_FRESHTEAM_SEEDS=
SCRAPPY_TRAKSTAR_SEEDS=
SCRAPPY_ORACLE_SEEDS=
SCRAPPY_SUCCESSFACTORS_SEEDS=
SCRAPPY_TALEO_SEEDS=
SCRAPPY_PERSONIO_SEEDS=
SCRAPPY_RIPPLING_SEEDS=
SCRAPPY_UKG_SEEDS=

# API keys for job board scrapers (required to function)
JAZZHR_API_KEY=
JOBTECHDEV_API_KEY=
WEB3CAREER_API_TOKEN=
TALROO_PUBLISHER_ID=
TALROO_PUBLISHER_PASS=
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# Limits
SCRAPPY_ATS_MAX_SEEDS=20      # Max company seeds to try per ATS scraper
